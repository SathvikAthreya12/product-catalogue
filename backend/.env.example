# Copy to .env to override defaults. Every value is optional for local development.
PORT=3000
FAKESTORE_BASE_URL=https://fakestoreapi.com

# Sales inbox that receives enquiries, and the sender address used for them
SALES_INBOX=sales@example.com
EMAIL_FROM=catalogue@example.com

# console = print emails to the terminal (default, no account needed)
# smtp    = send through any SMTP server (set the SMTP_* values below)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
